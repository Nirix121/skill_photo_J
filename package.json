{
  "name": "palmira-certificates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Выставление, хранение и верификация сертификатов подлинности",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
